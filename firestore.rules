rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check authentication
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Students collection rules
    match /students/{studentId} {
      allow read: if true; // Allow reading records (or restrict with isAuthenticated())
      allow create, update, delete: if true; // For production with Firebase Auth, change to: isAuthenticated()
    }
    
    // Teachers collection rules
    match /teachers/{teacherId} {
      allow read: if true;
      allow create, update, delete: if true; // Change to isAuthenticated() in production
    }
    
    // Application settings and state data
    match /app_data/{docId} {
      allow read: if true;
      allow write: if true; // Change to isAuthenticated() in production
    }
    
    // Default rule for all other collections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
